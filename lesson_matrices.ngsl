// ========================================
// レッスン 3: 行列と線形代数
// ========================================

// 1️⃣ 行列の作成
let A = matrix(c(1, 2, 3, 4), 2, 2);    // 2×2 行列
let B = matrix(c(5, 6, 7, 8), 2, 2);    // 別の2×2 行列

// 2️⃣ 行列演算
let C = A * B;                           // 行列乗法（BLAS）
let At = t(A);                           // 転置

// 3️⃣ 行列代数
let det_A = det(A);                      // 行列式（LAPACK）
let A_inv = inv(A);                      // 逆行列（LAPACK）

// 4️⃣ 線形方程式を解く
let b = c(3, 7);                         // 右辺ベクトル
let x = solve(A, b);                     // Ax = b を解く（LAPACK）

// 5️⃣ 行列の次元
let n_rows = nrow(A);                    // 行数
let n_cols = ncol(A);                    // 列数
let d = dim(A);                          // 次元（c(n, m)）
