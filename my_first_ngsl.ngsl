// ========================================
// My First NGSL Program
// ベクトル・統計の基礎を学ぶ
// ========================================

// 1️⃣ ベクトル作成（c関数）
let x = c(1, 2, 3, 4, 5);
let y = c(10, 20, 30, 40, 50);

// 2️⃣ ベクトル演算（要素ごと）
let z = x + y;                    // [11, 22, 33, 44, 55]

// 3️⃣ 基本統計関数
let mean_x = mean(x);             // 3.0
let var_x = var(x);               // データの分散
let sd_x = sd(x);                 // 標準偏差
let sum_x = sum(x);               // 合計 = 15

// 4️⃣ 他の統計量
let min_x = min(x);               // 最小値 = 1
let max_x = max(x);               // 最大値 = 5
let med_x = median(x);            // 中央値 = 3
