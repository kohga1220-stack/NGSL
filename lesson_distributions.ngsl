// ========================================
// レッスン 2: 確率分布
// ========================================

// 1️⃣ 正規分布から乱数を生成
let samples = rnorm(100, 0, 1);     // 平均0、標準偏差1の100個のサンプル

// 2️⃣ サンプルの統計量を計算
let sample_mean = mean(samples);     // サンプル平均（≈ 0）
let sample_sd = sd(samples);         // サンプル標準偏差（≈ 1）

// 3️⃣ 確率分布関数を使用
let density_at_0 = dnorm(0, 0, 1);   // x=0での確率密度
let prob_less_than_1 = pnorm(1, 0, 1);  // P(X ≤ 1)
let quantile_95 = qnorm(0.95, 0, 1);    // 95パーセンタイル

// 4️⃣ 相関分析の準備
let x = seq(1, 50, 1);              // 1から50まで
let y = x * 2 + rnorm(50, 0, 5);    // y = 2x + 誤差
let correlation = cor(x, y);         // xとyの相関係数
